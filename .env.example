# Локальные настройки разработки; пароль не предназначен для публичного сервера.
POSTGRES_PASSWORD=docmind_dev
POSTGRES_PORT=55432
API_PORT=8080
DATABASE_URL=postgres://docmind:docmind_dev@127.0.0.1:55432/docmind?sslmode=disable
HTTP_ADDR=127.0.0.1:8080
LOG_LEVEL=INFO
HTTP_READ_HEADER_TIMEOUT=5s
